# ---------------------------------------------------------------------------
# ALLOW-LIST: only the important project files are uploaded to GitHub.
# Everything in the top-level folder is ignored unless it is listed below, so a
# stray backup, export or test file can never be committed by accident (also not
# by auto-push). To publish a NEW top-level file/folder, add a "!/name" line.
# ---------------------------------------------------------------------------
/*

# source code
!/app/
!/core/
!/integrations/
!/security/
!/services/
!/scripts/
!/main.py
!/build.py
!/requirements.txt

# installer, build helpers, CI (the workflow uploads the Setup to the release)
!/installer/
!/make_exe.bat
!/make_installer.bat
!/start_launcher.bat
!/.github/

# documentation, license, icon
!/README.md
!/CHANGELOG.md
!/LICENSE
!/PLAYTIME_TRACKER.md
!/documentation/
!/icon.ico
!/assets/

# repo config
!/.gitignore
!/.gitattributes

# ---------------------------------------------------------------------------
# Never upload these, even inside the allowed folders
# ---------------------------------------------------------------------------
# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.env
.venv/
venv/

# Logs, user data and exports (accounts, settings, personal data)
*.log
logs/
data/
config.json
*.enc.json
accounts*.json
launcher_export_*.txt
playtime_stats.txt
*.part

# Build output, backups, local notes
*.spec
build/
dist/
*.exe
*.bak
zettel*.txt
test_*.py

# OS / IDE / tools
.DS_Store
Thumbs.db
.vscode/
.idea/
.claude/
